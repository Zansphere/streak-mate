# Template for release signing.
# 1. Generate your keystore:
#    keytool -genkey -v -keystore streakmate-upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to "key.properties" in the same directory (streakmate_app/android/key.properties).
# 3. Replace the placeholder values below with your actual keystore details:
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
storeFile=streakmate-upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD

